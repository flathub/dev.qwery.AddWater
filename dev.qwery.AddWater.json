{
    "id" : "dev.qwery.AddWater",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "addwater",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=~/.mozilla/firefox/:rw",
        "--filesystem=xdg-config/mozilla/firefox/:rw",
        "--filesystem=~/.var/app/org.mozilla.firefox/.mozilla/firefox/:rw",
        "--filesystem=~/.var/app/org.mozilla.firefox/config/mozilla/firefox/:rw",
        "--filesystem=~/snap/firefox/common/.mozilla/firefox/:rw",
        "--filesystem=~/snap/firefox/common/.config/mozilla/firefox/:rw",
        "--filesystem=~/.librewolf/:rw",
        "--filesystem=xdg-config/librewolf/librewolf:rw",
        "--filesystem=~/.var/app/io.gitlab.librewolf-community/.librewolf/:rw",
        "--filesystem=~/.var/app/io.gitlab.librewolf-community/config/librewolf/librewolf/:rw",
        "--filesystem=~/.floorp/:rw",
        "--filesystem=~/.var/app/one.ablaze.floorp/.floorp/:rw",
        "--filesystem=~/.waterfox/:rw",
        "--filesystem=~/.var/app/net.waterfox.waterfox/.waterfox:rw",
        "--filesystem=~/.cachy/:rw"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0",
        "/share/vala"
    ],
    "cleanup-commands": [
        "python3 -m compileall --invalidation-mode=unchecked-hash /app"
    ],
    "modules" : [
        "python3-requirements.json",
        {
            "name" : "libportal",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Ddocs=false",
                "-Dbackend-gtk4=enabled"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/flatpak/libportal",
                    "tag" : "0.9.1",
                    "commit" : "8f5dc8d192f6e31dafe69e35219e3b707bde71ce"
                }
            ]
        },
        {
            "name" : "addwater",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dprofile=default"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/largestgithubuseronearth/addwater",
                    "tag" : "v1.3",
                    "commit" : "6e9b2ea81f52074c8028d5b0afdce805bbb5921d"
                }
            ],
            "builddir" : true
        }
    ]
}
